<?xml version="1.0" encoding="UTF-8"?>
<!--
  smart-city-gui module POM.

  Java Swing desktop application. Depends on smart-city-core for all
  business logic. All long-running DB calls are dispatched off the EDT
  via SwingWorker (see controllers in this module).

  Output: executable JAR with main class = com.smartcity.ui.Main, packaged
  with the maven-shade-plugin so FlatLaf + MySQL Connector/J + core are
  all bundled and a single "java -jar smart-city-gui.jar" launches the app.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartcity</groupId>
        <artifactId>smart-city-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>smart-city-gui</artifactId>
    <packaging>jar</packaging>
    <name>Smart City - GUI</name>
    <description>Java Swing desktop UI on top of smart-city-core.</description>

    <dependencies>
        <dependency>
            <groupId>com.smartcity</groupId>
            <artifactId>smart-city-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>smart-city-gui</finalName>
        <plugins>
            <!-- Build an executable shaded JAR containing all runtime deps -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.smartcity.ui.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
